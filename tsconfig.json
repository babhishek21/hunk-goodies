{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["index.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
